# =============================================================================
# HireFast Environment Variables
# Copy this file to .env and fill in values. Never commit real credentials.
# =============================================================================

# Application
NODE_ENV=development
APP_NAME=HireFast
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PREFIX=/api/v1
PORT=4000
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgresql://hirefast:hirefast@localhost:5432/hirefast?schema=public
POSTGRES_USER=hirefast
POSTGRES_PASSWORD=hirefast
POSTGRES_DB=hirefast
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ORG_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hirefast
R2_PUBLIC_URL=
R2_ENDPOINT=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend — Candidate Portal
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Frontend — Admin Portal
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
