{
  "name": "hirefast",
  "version": "1.0.0",
  "private": true,
  "description": "HireFast — AI-powered employability assessment platform",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel --filter @hirefast/backend --filter @hirefast/candidate-portal --filter @hirefast/admin-portal dev",
    "dev:backend": "pnpm --filter @hirefast/backend dev",
    "dev:candidate": "pnpm --filter @hirefast/candidate-portal dev",
    "dev:admin": "pnpm --filter @hirefast/admin-portal dev",
    "build": "pnpm run -r --filter=./packages/* build && pnpm run -r --filter=./apps/* build",
    "build:backend": "pnpm --filter @hirefast/backend build",
    "build:candidate": "pnpm --filter @hirefast/candidate-portal build",
    "build:admin": "pnpm --filter @hirefast/admin-portal build",
    "lint": "pnpm run -r lint",
    "lint:fix": "pnpm run -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "test": "pnpm run -r test",
    "test:backend": "pnpm --filter @hirefast/backend test",
    "test:candidate": "pnpm --filter @hirefast/candidate-portal test",
    "test:admin": "pnpm --filter @hirefast/admin-portal test",
    "typecheck": "pnpm run -r typecheck",
    "db:generate": "pnpm --filter @hirefast/backend prisma:generate",
    "db:migrate": "pnpm --filter @hirefast/backend prisma:migrate",
    "db:migrate:dev": "pnpm --filter @hirefast/backend prisma:migrate:dev",
    "db:seed": "pnpm --filter @hirefast/backend prisma:seed",
    "db:studio": "pnpm --filter @hirefast/backend prisma:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx,js}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
